# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Raw dataset - CC BY 4.0, committed to this repo.
# See docs/dataset_source.md.

# Model binaries & resumable state - too large / created at runtime by the
# notebooks (these directories are rebuilt on demand, so no .gitkeep is needed).
custom_cnn/best_model/*
transfer_learning/best_model/*

# Plots and images - regenerate locally by running the notebooks.
custom_cnn/plots/*
transfer_learning/plots/*
outputs/comparison/*
outputs/website/*

# Keep logs and metrics CSVs
!custom_cnn/logs/*.csv
!custom_cnn/metrics/*.csv
!custom_cnn/metrics/*.json
!transfer_learning/logs/*.csv
!transfer_learning/metrics/*.csv
!transfer_learning/metrics/*.json

# OS
.DS_Store
Thumbs.db

# VS Code
.vscode/
